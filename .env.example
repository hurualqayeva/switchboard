# Copy to .env for local development. Never commit .env.
SWITCHBOARD_ENV=local
SWITCHBOARD_LOG_LEVEL=DEBUG
SWITCHBOARD_PORT=8000
SWITCHBOARD_DATABASE_URL=postgresql://switchboard:switchboard@localhost:5432/switchboard  # pragma: allowlist secret
SWITCHBOARD_REDIS_URL=redis://localhost:6379/0

# Provider credentials (phase 1). Leave empty to disable a provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=eu-central-1
AWS_PROFILE=
